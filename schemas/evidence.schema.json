{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/evidence.schema.json",
  "title": "Evidence Register",
  "description": "Schema for evidence items used by the fit-gap analysis engine.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["key", "present", "source", "notes"],
    "properties": {
      "key": {
        "type": "string",
        "description": "Unique evidence key matched against expected evidence in the control catalog."
      },
      "present": {
        "type": "boolean",
        "description": "Whether the evidence is currently present."
      },
      "source": {
        "type": ["string", "null"],
        "description": "Evidence source, such as GitHub settings, file path, cloud configuration, policy document or log source."
      },
      "notes": {
        "type": "string",
        "description": "Human-readable explanation of the evidence state."
      },
      "evidence_id": { "type": "string", "minLength": 1 },
      "control_id": { "type": "string", "minLength": 1 },
      "title": { "type": "string", "minLength": 1 },
      "source_type": { "enum": ["repository", "provider_api", "runtime_export", "manual_review", "document"] },
      "collected_at": { "type": "string", "format": "date-time" },
      "valid_until": { "type": "string", "format": "date-time" },
      "max_age_seconds": { "type": "integer", "minimum": 0 },
      "source_timestamp": { "type": "string", "format": "date-time" },
      "collector": { "type": "string", "minLength": 1 },
      "collector_version": { "type": "string", "minLength": 1 },
      "environment": { "type": "string", "minLength": 1 },
      "scope": { "type": "string", "minLength": 1 },
      "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
      "confidence": { "enum": ["high", "medium", "low"] },
      "status": {
        "enum": ["documented", "implemented", "tested", "observed", "operationally_proven", "unavailable", "not_applicable", "unverified"]
      },
      "verification_method": { "type": "string", "minLength": 1 },
      "integrity": {
        "type": "object",
        "required": ["algorithm", "digest"],
        "properties": {
          "algorithm": { "const": "sha256" },
          "digest": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
        },
        "additionalProperties": false
      },
      "integrity_payload": {
        "type": "string",
        "minLength": 1,
        "description": "Exact NFC-normalized UTF-8 payload whose SHA-256 digest is recorded in integrity.digest."
      },
      "limitations": { "type": "array", "items": { "type": "string" } },
      "related_controls": { "type": "array", "items": { "type": "string" } },
      "collection_context_id": { "type": "string", "minLength": 1 },
      "target_fingerprint": { "type": "string", "minLength": 1 },
      "binding_digest": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
      "repository_commit_sha": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" },
      "freshness_status": { "enum": ["FRESH", "STALE", "EXPIRED", "TIMESTAMP_MISSING", "CLOCK_SKEW_SUSPECTED", "NOT_APPLICABLE"] },
      "external_target": {
        "type": "object",
        "required": ["provider", "scopeId", "productBindingSignals"],
        "properties": {
          "provider": { "enum": ["aws", "azure", "gcp", "vercel", "generic"] },
          "scopeId": { "type": "string", "minLength": 1 },
          "endpoint": { "type": "string", "minLength": 1 },
          "region": { "type": "string", "minLength": 1 },
          "productBindingSignals": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  }
}
